DATABASE_URL=postgresql+asyncpg://leaf:leaf@localhost:5432/leaf
MODEL_DIR=./model_cache
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
DEFAULT_LANG=vi

# --- Security (required) -------------------------------------------------------------
# JWT signing key. The API refuses to start if it is missing or a known default.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Only if SECRET_KEY was rotated: the OLD value, so passwords hashed by old releases still verify.
LEGACY_SECRET_KEY=

# --- First admin (optional, only used when that phone is not registered yet) ---------
# Never overwrites an existing password. Alternative: python make_admin.py <phone> --password
ADMIN_PHONE=
ADMIN_PASSWORD=

# --- LLM connection (fallback when not set in Admin > AI Model settings) -------------
LLM_PROVIDER=cliproxy
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_NAME=gpt-5.5

# --- Optional --------------------------------------------------------------------------
# Extra trusted browser origins, comma-separated (production TUAF domains + localhost are built in)
CORS_ORIGINS=
# Diagnoses allowed per 10 minutes (per account / per guest IP)
PREDICT_RATE_LIMIT_USER=40
PREDICT_RATE_LIMIT_GUEST=60
